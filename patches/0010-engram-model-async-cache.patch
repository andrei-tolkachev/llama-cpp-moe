+// P13: the DeepSeek model owns the mmap-backed cache, never a graph input.
+llama_model_deepseek41::~llama_model_deepseek41() {
+    std::lock_guard<std::mutex> guard(experimental_engram_mutex);
+    if (experimental_engram_cache) {
+        experimental_engram_cache->close(); // drain worker before model buffers unmap
+        experimental_engram_cache.reset();
+    }
+}
+
+std::shared_ptr<llama_exp::engram_model_cache> llama_model_deepseek41::engram_cache_for(
+        llama_exp::mapped_rows source, uint64_t rows) const {
+    std::lock_guard<std::mutex> guard(experimental_engram_mutex);
+    if (!experimental_engram_cache) {
+        const char * flag = std::getenv("LLAMA_EXPERIMENTAL_ENGRAM_ASYNC");
+        const bool async = flag && flag[0] == '1' && flag[1] == '\0';
+        experimental_engram_cache = std::make_shared<llama_exp::engram_model_cache>(
+                source, rows, llama_exp::engram_model_cache::default_data_budget,
+                async ? llama_exp::engram_model_cache::async_queue_limit : 0);
+    } else if (!experimental_engram_cache->matches(source, rows)) {
+        throw std::runtime_error("DeepSeek-V4.1 Engram cache source changed after initialization");
+    }
+    return experimental_engram_cache;
+}
