// Reconstructed from the actual P16A process()/accept() snippets.
#include "mtp_verify_window.hpp"
#include <algorithm>
#include <cassert>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <stdexcept>
#include <vector>
using llama_seq_id = int32_t;
struct mock_context {
    std::vector<float> rows;
    int n_embd;
};
static const float * llama_get_embeddings_nextn_ith(const mock_context * ctx, int row) {
    if(row < 0 || (size_t)(row+1)*ctx->n_embd > ctx->rows.size())throw std::out_of_range("rows");
    return ctx->rows.data() + (size_t)row * ctx->n_embd;
}
struct virtual_mtp {
    virtual ~virtual_mtp()=default;
    virtual void accept(llama_seq_id, uint16_t, bool)=0;
};
struct bridge : virtual_mtp {
    struct { int n_max = 0; } params;
    bool bounded_verify_rows;
    int n_embd, n_seq;
    mock_context * ctx_tgt;
    std::vector<std::vector<float>> verify_h,pending_h;
    std::vector<int32_t> verify_h_rows,i_batch_beg,i_batch_end;
    bridge(mock_context * c,int nseq,int cap,bool en): bounded_verify_rows(en),n_embd(c->n_embd),n_seq(nseq),ctx_tgt(c),
        verify_h(nseq),pending_h(nseq,std::vector<float>((size_t)c->n_embd)),
        verify_h_rows(nseq),i_batch_beg(nseq,-1),i_batch_end(nseq,-1) {params.n_max=cap;}
    bool process() {
        const size_t row_bytes=(size_t)n_embd*sizeof(float);
@@P16_PROCESS@@
@@P16_ACCEPT@@
};
int main(){
    std::size_t cases=0;
    for(int cap : {0,1,4,8,20})for(int size: {1,3,9,33,129})for(int dim: {1,4,31}){
        mock_context ctx{{},dim};
        ctx.rows.resize((size_t)size *2*dim);
        for(size_t i=0;i<ctx.rows.size();++i)ctx.rows[i]=(float)(i%1024);
        const int max_drafted = std::max(1,cap);
        for(bool en:{false,true}){
            bridge b(&ctx,2,cap,en);
            b.i_batch_beg={0,size}; b.i_batch_end={size-1,2*size-1};
            assert(b.process());
            for(int seq=0;seq<2;++seq){
                const int first=seq*size;
                const int n_keep=en ? std::min(size,max_drafted+1):size;
                assert((int)b.verify_h[seq].size()==n_keep*dim);
                assert(std::memcmp(b.pending_h[seq].data(),ctx.rows.data()+((size_t)first+size-1)*dim,(size_t)dim*sizeof(float))==0);
                for(int accepted=0;accepted<=std::min(max_drafted,size-1);++accepted){
                    b.accept(seq,(uint16_t)accepted,false);
                    assert(std::memcmp(b.pending_h[seq].data(),ctx.rows.data()+((size_t)first+accepted)*dim,(size_t)dim*sizeof(float))==0);
                    cases++;
                }
                if(en && size>max_drafted+1){
                    bool invalid=false;
                    try {b.accept(seq,(uint16_t)(max_drafted+1),false);}catch(const std::out_of_range &) {invalid=true;}
                    assert(invalid);
                }
            }
        }
    }
    // The legacy multi-speculator path must still support acceptance > n_max.
    mock_context ctx{{},1};ctx.rows={1,2,3,4,5,6};
    bridge multi(&ctx,1,1,false);multi.i_batch_beg={0};multi.i_batch_end={5};
    assert(multi.process());multi.accept(0,5,true);assert(multi.pending_h[0][0]==6.0f);
    std::cout<<"P16A source-extracted process/accept parity "<<cases<<" PASS\n";
}
