 // The hash runs host-side because ggml has no int64 and no xor. EOS resets the window.
 
+// Exact integer prefix reuse; this does not change PLE rows or table precision.
+static bool qwen4exp_hash_scratch_enabled() {
+    const char * value = std::getenv("LLAMA_EXPERIMENTAL_HASH_SCRATCH");
+    return value && value[0] == '1' && value[1] == '\0';
+}
