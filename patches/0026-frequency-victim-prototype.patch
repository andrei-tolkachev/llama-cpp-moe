+    bool colder(int32_t a, int32_t b) const {
+        const float ua = key_of[a] < 0 ? -1.0f : usage[key_of[a]];
+        const float ub = key_of[b] < 0 ? -1.0f : usage[key_of[b]];
+        if (ua != ub) return ua < ub;
+        if (touched[a] != touched[b]) return touched[a] < touched[b];
+        return a < b;
+    }
+
+    void heap_swap(size_t a, size_t b) {
+        std::swap(heap[a], heap[b]);
+        heap_pos[heap[a]] = int32_t(a);
+        heap_pos[heap[b]] = int32_t(b);
+    }
+
+    void heap_up(size_t i) {
+        while (i > 0 && colder(heap[i], heap[(i - 1)/2])) {
+            heap_swap(i, (i - 1)/2);
+            i = (i - 1)/2;
+        }
+    }
+
+    void heap_down(size_t i) {
+        while (2*i + 1 < heap.size()) {
+            size_t c = 2*i + 1;
+            if (c + 1 < heap.size() && colder(heap[c + 1], heap[c])) ++c;
+            if (!colder(heap[c], heap[i])) break;
+            heap_swap(i, c);
+            i = c;
+        }
+    }
+
+    void heap_remove(int32_t s) {
+        const size_t i = heap_pos[s];
+        GGML_ASSERT(i < heap.size() && heap[i] == s);
+        heap_swap(i, heap.size() - 1);
+        heap.pop_back();
+        heap_pos[s] = -1;
+        if (i < heap.size()) {
+            if (i > 0 && colder(heap[i], heap[(i - 1)/2])) heap_up(i);
+            else heap_down(i);
+        }
+    }
