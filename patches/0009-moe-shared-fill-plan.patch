+// P12: prefer a single immutable group layout shared by all bank widths.
+// The P04 implementation remains byte-for-byte the fallback when disabled.
+template <typename Upload>
+static moe_cache_upload_stats llama_moe_cache_upload_experts_planned(
+        const uint8_t * source, size_t expert_size, const std::vector<moe_cache_slru::fill> & fills,
+        uint8_t * staging, size_t capacity, size_t & used,
+        const llama_exp::moe_fill_plan * shared_plan, Upload upload) {
+    if (shared_plan == nullptr) {
+        return llama_moe_cache_upload_experts(source, expert_size, fills,
+                                             staging, capacity, used, upload);
+    }
+    const auto m = shared_plan->upload(source, expert_size, staging, capacity, used, upload);
+    return {m.bytes, m.staged_bytes, m.calls, m.calls_saved};
+}
