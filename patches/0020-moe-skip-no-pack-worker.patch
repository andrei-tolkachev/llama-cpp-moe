+// P04 only packs across a boundary between two different source runs
+// with consecutive destination slots. No such pair means no CPU packing
+// for any bank width or staging budget. SLRU-selected IDs are unchanged.
+static bool moe_prepare_inline(const std::vector<moe_cache_slru::fill> & fills) {
+    static const bool enabled = [] {
+        const char * env = std::getenv("LLAMA_EXPERIMENTAL_MOE_BYPASS_NO_PACK");
+        return env && env[0] == '1' && env[1] == '\0';
+    }();
+    return enabled && std::adjacent_find(fills.begin(), fills.end(), [](const auto & a, const auto & b) {
+        return int64_t(b.slot) == int64_t(a.slot) + 1 && int64_t(b.expert) != int64_t(a.expert) + 1;
+    }) == fills.end();
+}
