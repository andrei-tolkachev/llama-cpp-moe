+// Called AFTER the server has restored target/draft model checkpoints.
+// Do not erase impl_last: replay still needs the original drafter's accept().
+void common_speculative_checkpoint_rewind(common_speculative * spec, llama_seq_id seq_id) {
+    if (!spec) {
+        return;
+    }
+    if (seq_id < 0 || (size_t) seq_id >= spec->dparams.size()) {
+        throw std::out_of_range("speculative rewind has invalid sequence id");
+    }
+    for (auto & impl : spec->impls) {
+        impl->rewind_after_checkpoint(seq_id);
+    }
+}
+
+void common_speculative_discard_pending(common_speculative * spec, llama_seq_id seq_id) {
+    if (!spec || seq_id < 0 || (size_t) seq_id >= spec->dparams.size()) {
+        return;
+    }
+    for (auto & impl : spec->impls) {
+        impl->discard_pending(seq_id);
+    }
+}
