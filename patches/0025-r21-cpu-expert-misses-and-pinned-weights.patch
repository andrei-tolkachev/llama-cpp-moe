+            const size_t bytes = ggml_nbytes(w);
+            if (!addr || bytes > std::numeric_limits<uintptr_t>::max() - page ||
+                    addr > std::numeric_limits<uintptr_t>::max() - bytes - page) return;
+            ranges.emplace_back(addr / page * page, (addr + bytes + page - 1) / page * page);
+        }
+        std::sort(ranges.begin(), ranges.end());
+        std::vector<range> merged;
+        for (const auto & r : ranges) {
+            if (!merged.empty() && r.first <= merged.back().second) {
+                merged.back().second = std::max(merged.back().second, r.second);
+            } else merged.push_back(r);
