+size_t llama_model::moe_release_file_cache(const void * ptr, size_t bytes) const {
+    const uintptr_t first = reinterpret_cast<uintptr_t>(ptr);
+    if (bytes > std::numeric_limits<uintptr_t>::max() - first) return 0;
+    const uintptr_t last = first + bytes;
+    size_t advised = 0;
+    for (const auto & mapping : pimpl->mappings) {
+        const uintptr_t base = reinterpret_cast<uintptr_t>(mapping->addr());
+        const uintptr_t lo = std::max(first, base);
+        const uintptr_t hi = std::min(last, base + mapping->size());
+        if (lo < hi) advised += mapping->release_file_cache(lo - base, hi - base);
+    }
+    return advised;
+}
