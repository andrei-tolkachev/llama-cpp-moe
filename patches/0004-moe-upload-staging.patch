+// An opt-in limit, in whole MiB. Invalid input disables the experiment rather
+// than silently accepting a partial decimal or an unbounded allocation.
+static size_t llama_moe_cache_staging_limit(const char * value, bool & invalid) {
+    invalid = false;
+    if (value == nullptr || value[0] == '\0') {
+        return 0;
+    }
+    size_t mib = 0;
+    for (const char * p = value; *p != '\0'; ++p) {
+        if (*p < '0' || *p > '9') {
+            invalid = true;
+            return 0;
+        }
+        mib = mib*10 + size_t(*p - '0');
+        if (mib > 64) {
+            invalid = true;
+            return 0;
+        }
+    }
+    return mib*1024*1024;
+}
+
+static ggml_backend_buffer_ptr llama_moe_cache_alloc_staging(ggml_backend_t backend, size_t limit, bool no_alloc) {
+    if (no_alloc || limit == 0) {
+        return nullptr;
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    ggml_backend_dev_props props = {};
+    ggml_backend_dev_get_props(dev, &props);
+    if (!props.caps.async || !props.caps.host_buffer) {
+        return nullptr;
+    }
+    ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(dev);
+    if (buft == nullptr || !ggml_backend_buft_is_host(buft) || ggml_backend_buft_get_max_size(buft) < limit) {
+        return nullptr;
+    }
+    ggml_backend_buffer_ptr buffer(ggml_backend_buft_alloc_buffer(buft, limit));
+    // CUDA_Host can fall back to a pageable CPU buffer. A host pointer alone is
+    // not evidence of pinning: retain only the device's advertised host type.
+    if (!buffer || ggml_backend_buffer_get_type(buffer.get()) != buft ||
+            !ggml_backend_buffer_is_host(buffer.get()) ||
+            ggml_backend_buffer_get_size(buffer.get()) < limit ||
+            ggml_backend_buffer_get_size(buffer.get()) > size_t(64)*1024*1024 ||
+            ggml_backend_buffer_get_base(buffer.get()) == nullptr) {
+        return nullptr;
+    }
+    return buffer;
+}
+
+struct moe_cache_upload_stats {
+    size_t bytes        = 0;
+    size_t staged_bytes = 0;
+    size_t calls        = 0;
+    size_t calls_saved  = 0;
+};
+
+// Preserve the SLRU fill order and every destination slot. Gather only a run
+// of adjacent destination slots when its source experts are not adjacent.
+// The cursor is shared by ALL banks in one cache update: queued async readers
+// must never observe a range overwritten by a later bank in that update.
+template <typename Upload>
+static moe_cache_upload_stats llama_moe_cache_upload_experts(
+        const uint8_t * source, size_t expert_size, const std::vector<moe_cache_slru::fill> & fills,
+        uint8_t * staging, size_t capacity, size_t & used, Upload upload) {
+    GGML_ASSERT(expert_size > 0 && used <= capacity);
+    moe_cache_upload_stats stats;
+    for (size_t i = 0; i < fills.size();) {
+        size_t direct_n = 1;
+        while (i + direct_n < fills.size() &&
+                fills[i + direct_n].expert == fills[i].expert + (int32_t) direct_n &&
+                fills[i + direct_n].slot   == fills[i].slot   + (int32_t) direct_n) {
+            direct_n++;
+        }
+
+        size_t packed_n = direct_n;
+        // Division bounds the multiplication and makes exhaustion a direct
+        // upload fallback. There is no wrap, wait, growth or hot allocation.
+        const size_t fits = staging != nullptr ? (capacity - used)/expert_size : 0;
+        while (packed_n < fits && i + packed_n < fills.size() &&
+                fills[i + packed_n].slot == fills[i].slot + (int32_t) packed_n) {
+            // Do not split an existing direct run at the capacity boundary:
+            // its remainder would need another upload and erase the saving.
+            size_t n = 1;
+            while (i + packed_n + n < fills.size() &&
+                    fills[i + packed_n + n].expert == fills[i + packed_n].expert + (int32_t) n &&
+                    fills[i + packed_n + n].slot   == fills[i + packed_n].slot   + (int32_t) n) {
+                n++;
+            }
+            if (n > fits - packed_n) {
+                break;
+            }
+            packed_n += n;
+        }
+        if (packed_n > direct_n) {
+            size_t fragments = 0;
+            for (size_t j = 0; j < packed_n;) {
+                size_t n = 1;
+                while (j + n < packed_n && fills[i + j + n].expert == fills[i + j].expert + (int32_t) n) {
+                    n++;
+                }
+                std::memcpy(staging + used + j*expert_size,
+                            source + size_t(fills[i + j].expert)*expert_size, n*expert_size);
+                fragments++;
+                j += n;
+            }
+            const size_t bytes = packed_n*expert_size;
+            upload(staging + used, size_t(fills[i].slot)*expert_size, bytes);
+            used += bytes;
+            stats.bytes        += bytes;
+            stats.staged_bytes += bytes;
+            stats.calls++;
+            stats.calls_saved += fragments - 1;
+            i += packed_n;
+        } else {
+            const size_t bytes = direct_n*expert_size;
+            upload(source + size_t(fills[i].expert)*expert_size, size_t(fills[i].slot)*expert_size, bytes);
+            stats.bytes += bytes;
+            stats.calls++;
+            i += direct_n;
+        }
+    }
+    return stats;
+}
