+bool moe_cache_slru::plan_frequency(int32_t il, std::vector<fill> & fills, size_t & n_hit) {
+    // Strata defaults to usage decay 0.7; decay once per 16 layer sweeps here.
+    // Rebuild after rounding: equal scores still need the recency tie-breaker.
+    if (++frequency_calls % (16*slot_map.size()) == 0) {
+        for (auto & u : usage) u *= 0.7f;
+        for (size_t i = heap.size()/2; i > 0; --i) heap_down(i - 1);
+    }
+    int32_t * slots = slot_map[il];
+    for (int32_t e : uniq) {
+        if (slots[e] >= 0) {
+            heap_remove(slots[e]);
+            ++n_hit;
+        }
+        usage[size_t(il)*n_expert + e] += 1.0f;
+    }
+    std::sort(uniq.begin(), uniq.end());
+    for (int32_t e : uniq) {
+        if (slots[e] >= 0) continue;
+        GGML_ASSERT(!heap.empty());
+        const int32_t s = heap.front();
+        heap_remove(s);
+        if (key_of[s] >= 0) {
+            slot_map[key_of[s]/n_expert][key_of[s]%n_expert] = -1;
+        }
+        key_of[s] = il*n_expert + e;
+        slots[e] = s;
+        fills.push_back({ e, s });
+    }
+    // No currently selected slot can be recycled until all fills are assigned.
+    for (int32_t e : uniq) {
+        const int32_t s = slots[e];
+        touched[s] = frequency_calls;
+        heap_pos[s] = int32_t(heap.size());
+        heap.push_back(s);
+        heap_up(heap.size() - 1);
+    }
+    return true;
+}
 
 // An opt-in limit, in whole MiB. Invalid input disables the experiment rather
 // than silently accepting a partial decimal or an unbounded allocation.
