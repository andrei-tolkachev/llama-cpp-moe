+    // Called either during initialization or after a synchronized failed update.
+    // Preserve the borrowed host maps, but require a fresh fill of every bank.
+    void invalidate_banks() {
+        for (auto * slots : slot_map) {
+            if (slots) std::fill_n(slots, n_expert, -1);
+        }
+        std::fill(key_of.begin(), key_of.end(), -1);
+        std::fill(is_protected.begin(), is_protected.end(), false);
+        n_protected = 0;
+        head[1] = tail[1] = -1;
         for (int32_t s = 0; s < n_slots; ++s) {
             prev[s] = s - 1;
             next[s] = s + 1 < n_slots ? s + 1 : -1;
         }
         head[0] = 0;
         tail[0] = n_slots - 1;
