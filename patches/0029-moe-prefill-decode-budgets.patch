+bool llama_context::moe_phase_select(uint32_t n_tokens) {
+    if (!moe_phase_prefill_ubatch) {
+        return true;
+    }
+    if (moe_phase_failed || !moe_cache) {
+        return false;
+    }
+
+    // Keep short prompts on the measured decode path. A large prompt can end with a small tail.
+    const bool prefill = n_tokens > 256;
+    if (prefill == moe_phase_prefill) {
+        return true;
+    }
+
+    const int64_t started = ggml_time_us();
+    synchronize();
+    auto host_registration = moe_cache->retain_host_registration();
+    moe_cache->finish_upload_events();
+    for (auto & res : gf_res_prev) {
+        res.reset();
+    }
+    gf_res_prev_active = nullptr;
+    gf_res_reserve.reset();
+    sched.reset();
+    moe_cache.reset();
+
+    cparams.moe_cache_size = prefill ? moe_phase_prefill_bytes : moe_phase_decode_bytes;
+    cparams.n_ubatch = prefill ? moe_phase_prefill_ubatch : 16;
+    sched_need_reserve = true;
+    try {
+        moe_cache = std::make_unique<llama_moe_cache>(model, false, backend_ptrs, backend_buft, cparams.moe_cache_size,
+                std::move(host_registration));
+        sched_reserve();
+    } catch (const std::exception & e) {
+        moe_phase_failed = true;
+        LLAMA_LOG_ERROR("%s: phase change failed; recreate the context before retrying: %s\n", __func__, e.what());
+        return false;
+    }
+    moe_phase_prefill = prefill;
+    LLAMA_LOG_INFO("%s: %s, cache %zu MiB, ubatch %u, transition %.3f ms, KV retained\n", __func__,
+            prefill ? "prefill" : "decode", cparams.moe_cache_size / (1024u * 1024u), cparams.n_ubatch,
+            (ggml_time_us() - started) / 1000.0);
+    return true;
+}
