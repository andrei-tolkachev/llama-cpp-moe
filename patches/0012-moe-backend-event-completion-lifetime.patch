+// P14B adapter to the pinned ggml backend event API. No new stream.
+// If event_new() returns nullptr, drain() uses the full backend sync.
+struct moe_ggml_upload_event_adapter {
+    using backend_type = ggml_backend_t;
+    using event_type = ggml_backend_event_t;
+
+    static event_type create(backend_type b) {
+        return ggml_backend_event_new(ggml_backend_get_device(b));
+    }
+    static void record(event_type e, backend_type b) {
+        ggml_backend_event_record(e, b);
+    }
+    static void synchronize_event(event_type e) {
+        ggml_backend_event_synchronize(e);
+    }
+    static void synchronize_backend(backend_type b) {
+        ggml_backend_synchronize(b);
+    }
+    static void destroy(event_type e) {
+        ggml_backend_event_free(e);
+    }
+};
+using moe_ggml_upload_completion = llama_exp::moe_upload_completion<moe_ggml_upload_event_adapter>;
