+// The CUDA kernel accepts strided F32 inputs, with strides measured in floats.
+// Check the actual graph inputs, including prefill batches, before constructing
+// the op; a successful one-token reserve probe alone is not sufficient.
+static bool dsv4_hc_post_layer_layout(
+        const ggml_tensor * x,
+        const ggml_tensor * residual,
+        const ggml_tensor * post,
+        const ggml_tensor * comb) {
+    if (!x || !residual || !post || !comb) {
+        return false;
+    }
+    for (const ggml_tensor * t : {x, residual, post, comb}) {
+        if (t->type != GGML_TYPE_F32 || t->view_offs % sizeof(float) != 0) {
+            return false;
+        }
+        for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+            if (t->ne[d] <= 0 || t->nb[d] % sizeof(float) != 0) {
+                return false;
+            }
+        }
+    }
+
+    const int64_t hc = 4;
+    const int64_t nt = x->ne[1];
+    return x->ne[2] == 1 && x->ne[3] == 1 &&
+        residual->ne[0] == x->ne[0] && residual->ne[1] == hc && residual->ne[2] == nt && residual->ne[3] == 1 &&
+        post->ne[0] == hc && post->ne[1] == nt && post->ne[2] == 1 && post->ne[3] == 1 &&
+        comb->ne[0] == hc && comb->ne[1] == hc && comb->ne[2] == nt && comb->ne[3] == 1;
+}
