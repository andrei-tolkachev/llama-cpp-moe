+        size_t total = 0;
+        for (const auto & r : merged) {
+            const size_t bytes = r.second - r.first;
+            if (bytes > cap - total) {
+                LLAMA_LOG_INFO("llama_moe_cache: host registration skipped: expert set exceeds %llu MiB cap\n", mib);
+                return;
