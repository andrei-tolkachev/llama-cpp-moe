+// Sample once per CPU backend library. Called only by a compiled, eligible IQ3_XXS kernel.
+extern "C" bool ggml_cpu_iq3_xxs_signmask_enabled(void) {
+    static const bool enabled = [] {
+        const char * flag = std::getenv("LLAMA_EXPERIMENTAL_CPU_IQ3_SIGNMASK");
+        const bool on = flag && flag[0] == '1' && flag[1] == '\0';
+        if (on) {
+            GGML_LOG_INFO("experimental_cpu_iq3_signmask: entered x86 IQ3_XXS x Q8_K dot product\n");
+        }
+        return on;
+    }();
+    return enabled;
+}
 
