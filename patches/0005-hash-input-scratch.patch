+static void qwen4exp_hash_rows_reuse(
+        const llama_hparams & hparams, const int64_t * ctx, int32_t * rows) {
+    uint64_t mixed = (uint64_t) ctx[0] * hparams.ple_layer_multipliers[0];
+    for (uint32_t n = 2; n <= hparams.ple_ngram_size; ++n) {
+        mixed ^= (uint64_t) ctx[n - 1] * hparams.ple_layer_multipliers[n - 1];
+        const uint32_t base = (n - 2) * hparams.ple_heads_per_ngram;
+        for (uint32_t g = 0; g < hparams.ple_heads_per_ngram; ++g) {
+            const uint32_t h_i = base + g;
+            rows[h_i] = (int32_t) (mixed % hparams.ple_head_vocab_sizes[h_i] +
+                                   hparams.ple_head_offsets[h_i]);
+        }
+    }
+}
